# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# PiProxyGuard Web API — multi-arch image (linux/amd64 + linux/arm64).
#
# The build stage is pinned to the *build* platform ($BUILDPLATFORM) so the
# .NET SDK always runs natively (no QEMU emulation of the compiler). The publish
# is framework-dependent, so the produced IL + bundled native assets
# (incl. linux-arm64 libe_sqlite3.so) run unchanged on the target runtime image,
# which buildx pulls for the requested $TARGETPLATFORM. Result: fast arm64
# builds on an amd64 host / CI runner.
#
#   docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.api .
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Restore against the manifest first so layers cache when only code changes.
COPY *.sln Directory.*.props Directory.*.targets nuget.config ./
COPY src/PiProxyGuard.Domain/*.csproj src/PiProxyGuard.Domain/
COPY src/PiProxyGuard.Infrastructure/*.csproj src/PiProxyGuard.Infrastructure/
COPY src/PiProxyGuard.Api/*.csproj src/PiProxyGuard.Api/
COPY src/PiProxyGuard.Worker/*.csproj src/PiProxyGuard.Worker/
COPY tests/PiProxyGuard.Tests/*.csproj tests/PiProxyGuard.Tests/
RUN dotnet restore src/PiProxyGuard.Api/PiProxyGuard.Api.csproj

COPY . .
RUN dotnet publish src/PiProxyGuard.Api/PiProxyGuard.Api.csproj \
    -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://0.0.0.0:5080 \
    DOTNET_NOLOGO=1
COPY --from=build /app ./
EXPOSE 5080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["sh", "-c", "wget -qO- http://127.0.0.1:5080/health || exit 1"]

ARG VERSION=1.2.0
LABEL org.opencontainers.image.title="PiProxyGuard API" \
      org.opencontainers.image.description="Home proxy statistics and protection for a Raspberry Pi (.NET 9)." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENTRYPOINT ["dotnet", "PiProxyGuard.Api.dll"]
