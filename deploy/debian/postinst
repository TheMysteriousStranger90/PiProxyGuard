#!/bin/sh
# PiProxyGuard postinst: provisions Squid + service user and starts everything.
set -e

APP_USER=piproxyguard
INSTALL_DIR=/opt/piproxyguard
DATA_DIR=/var/lib/piproxyguard
SQUID_CONF=/etc/squid/squid.conf
ACL_FILE=/etc/squid/blocked_domains.acl
SQUID_LOG=/var/log/squid/access.log
SAMPLE=/usr/share/piproxyguard/squid.conf.sample

case "$1" in
  configure)
    # --- service user ---
    if ! getent passwd "$APP_USER" >/dev/null 2>&1; then
        adduser --system --group --no-create-home --shell /usr/sbin/nologin "$APP_USER" \
            >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin "$APP_USER"
    fi
    if getent group proxy >/dev/null 2>&1; then
        adduser "$APP_USER" proxy >/dev/null 2>&1 || usermod -aG proxy "$APP_USER" 2>/dev/null || true
    fi

    # --- dirs + acl ---
    mkdir -p "$DATA_DIR" "$(dirname "$SQUID_LOG")"
    [ -f "$ACL_FILE" ] || : > "$ACL_FILE"
    chmod 644 "$ACL_FILE"
    chown -R "$APP_USER":"$APP_USER" "$DATA_DIR" "$INSTALL_DIR" 2>/dev/null || true
    chown "$APP_USER":"$APP_USER" "$ACL_FILE" 2>/dev/null || true
    chmod +x "$INSTALL_DIR/api/PiProxyGuard.Api" "$INSTALL_DIR/worker/PiProxyGuard.Worker" 2>/dev/null || true

    SQUID_BIN="$(command -v squid 2>/dev/null || echo /usr/sbin/squid)"

    # --- squid.conf (don't clobber a config already set up for us) ---
    if [ -f "$SQUID_CONF" ] && grep -q "blocked_domains.acl" "$SQUID_CONF" 2>/dev/null; then
        :
    else
        if [ -f "$SQUID_CONF" ]; then
            cp -a "$SQUID_CONF" "${SQUID_CONF}.bak.$(date +%Y%m%d%H%M%S)" || true
        fi
        [ -f "$SAMPLE" ] && cp "$SAMPLE" "$SQUID_CONF"
    fi

    # --- let the worker reload squid without a password ---
    echo "$APP_USER ALL=(root) NOPASSWD: $SQUID_BIN -k reconfigure" > /etc/sudoers.d/piproxyguard
    chmod 440 /etc/sudoers.d/piproxyguard

    # --- point BOTH services at the sudo reload + correct paths ---
    # The API hosts the dashboard in-process, so manual block/allow changes made
    # there also rewrite the ACL and must be able to reconfigure squid. If only
    # the worker gets the sudo reload command, manual blocks fail to reload and
    # SquidAclWriter rolls the ACL back, so they silently never take effect.
    if command -v jq >/dev/null 2>&1; then
        WORKER_CFG="$INSTALL_DIR/worker/appsettings.json"
        if [ -f "$WORKER_CFG" ]; then
            tmp="$(mktemp)"
            if jq --arg rc "sudo $SQUID_BIN -k reconfigure" \
                  '.Blocklist.ReloadCommand=$rc
                   | .AccessLog.Path="/var/log/squid/access.log"
                   | .ConnectionStrings.Default="Data Source=/var/lib/piproxyguard/piproxyguard.db"' \
                  "$WORKER_CFG" > "$tmp" 2>/dev/null; then
                mv "$tmp" "$WORKER_CFG"
                chown "$APP_USER":"$APP_USER" "$WORKER_CFG" 2>/dev/null || true
            else
                rm -f "$tmp"
            fi
        fi

        API_CFG="$INSTALL_DIR/api/appsettings.json"
        if [ -f "$API_CFG" ]; then
            tmp="$(mktemp)"
            if jq --arg rc "sudo $SQUID_BIN -k reconfigure" \
                  '.Blocklist.ReloadCommand=$rc' \
                  "$API_CFG" > "$tmp" 2>/dev/null; then
                mv "$tmp" "$API_CFG"
                chown "$APP_USER":"$APP_USER" "$API_CFG" 2>/dev/null || true
            else
                rm -f "$tmp"
            fi
        fi
    fi

    # --- systemd ---
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable squid >/dev/null 2>&1 || true
        systemctl restart squid || true
        systemctl enable --now piproxyguard-worker.service piproxyguard-api.service || true
    fi

    # --- optional: whole-LAN transparent interception ---
    # Off by default (plain forward proxy on :3128). Turn it on with either:
    #   sudo PIPROXYGUARD_TRANSPARENT=1 apt install ./piproxyguard_*_arm64.deb
    #   sudo piproxyguard-transparent enable        # any time after install
    # Once enabled the choice is remembered in /etc/piproxyguard/transparent.conf
    # and re-applied automatically on every upgrade.
    TRANSPARENT_CONF=/etc/piproxyguard/transparent.conf
    ENGINE=/usr/lib/piproxyguard/transparent-setup.sh
    WANT_TRANSPARENT=0
    case "$(printf '%s' "${PIPROXYGUARD_TRANSPARENT:-}" | tr 'A-Z' 'a-z')" in
        1|y|yes|true|on) WANT_TRANSPARENT=1 ;;
    esac
    if [ "$WANT_TRANSPARENT" -eq 0 ] && [ -f "$TRANSPARENT_CONF" ] \
       && grep -q '^TRANSPARENT_ENABLED=1' "$TRANSPARENT_CONF" 2>/dev/null; then
        WANT_TRANSPARENT=1
    fi
    if [ "$WANT_TRANSPARENT" -eq 1 ] && [ -x "$ENGINE" ]; then
        echo "Enabling whole-LAN transparent interception..."
        # never fail the install if the network setup hiccups
        sh "$ENGINE" enable || echo "WARNING: transparent setup reported an error (package install continues)."
    fi

    # --- optional: upstream tunnel (route selected domains via a parent proxy) ---
    # Shipped with the package as /usr/bin/piproxyguard-upstream. It is NOT enabled
    # automatically because it needs an external parent proxy and its host:port:
    #   sudo piproxyguard-upstream enable <host> <port>   # e.g. 10.8.0.1 8888
    #   sudo piproxyguard-upstream status
    #   sudo piproxyguard-upstream disable                # all domains go direct again
    # The parent proxy (VPN/Tor/corporate) must already exist and be reachable from
    # the Pi - the package cannot bring it up. Manage the tunneled-domain list from
    # the dashboard's "Upstream tunnel" page (or POST /api/tunnel).

    IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$IP" ] || IP="<pi-ip>"
    echo "PiProxyGuard installed. Dashboard: http://$IP:5080/   Proxy: $IP:3128"
    if [ "$WANT_TRANSPARENT" -eq 1 ]; then
        echo "Transparent mode ON. Final step (router/DHCP): set the LAN gateway to $IP so all devices route through this Pi."
    fi
    if [ -x /usr/lib/piproxyguard/upstream-setup.sh ]; then
        echo "Upstream tunnel available: 'sudo piproxyguard-upstream enable <host> <port>' to route selected domains via a parent proxy."
    fi
    ;;
esac

exit 0
