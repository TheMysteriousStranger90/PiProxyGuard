# Minimal Squid configuration for a home Raspberry Pi proxy with PiProxyGuard.
# Place as /etc/squid/squid.conf (merge with your existing config).

# --- Local network ---
acl localnet src 192.168.0.0/16
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src fc00::/7

# --- PiProxyGuard blocklist ---
# The ACL file is generated and refreshed automatically by the Worker.
acl piproxyguard_blocked dstdomain "/etc/squid/blocked_domains.acl"
http_access deny piproxyguard_blocked

# --- PiProxyGuard upstream tunnel (optional, v1.8.0) ---
# Route ONLY selected domains through a parent proxy (VPN-side proxy, Tor, ...),
# everything else stays direct. Manage the domain list from the dashboard
# (Upstream tunnel page) or POST /api/tunnel; PiProxyGuard fills tunnel_domains.acl.
# Easiest: run  deploy/upstream-tunnel/setup-upstream.sh enable <host> <port>
# Or uncomment and edit the lines below (replace UPSTREAM_HOST / UPSTREAM_PORT):
#cache_peer UPSTREAM_HOST parent UPSTREAM_PORT 0 no-query default name=ppg_upstream
#acl piproxyguard_tunnel dstdomain "/etc/squid/tunnel_domains.acl"
#cache_peer_access ppg_upstream allow piproxyguard_tunnel
#cache_peer_access ppg_upstream deny all
#never_direct allow piproxyguard_tunnel
# NOTE: never_direct = no direct fallback; if the parent is down those domains stop.

# --- Standard access rules ---
acl SSL_ports port 443
acl Safe_ports port 80 443 21 1025-65535
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost manager
http_access deny manager
http_access allow localnet
http_access allow localhost
http_access deny all

http_port 3128

# --- Logging (native format is what PiProxyGuard parses) ---
logformat squid %ts.%03tu %6tr %>a %Ss/%03>Hs %<st %rm %ru %[un %Sh/%<a %mt
access_log /var/log/squid/access.log squid

# Keep DNS lookups fast on a Pi
dns_v4_first on
