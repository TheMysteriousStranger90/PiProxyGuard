[Unit]
Description=PiProxyGuard Worker (log ingestion, blocklist updates, anomaly detection)
After=network-online.target squid.service
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/piproxyguard/worker
ExecStart=/opt/piproxyguard/worker/PiProxyGuard.Worker
Restart=on-failure
RestartSec=10
User=piproxyguard
# Reading squid logs usually requires membership in the "proxy" group.
SupplementaryGroups=proxy
Environment=DOTNET_gcServer=0

[Install]
WantedBy=multi-user.target
