<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- This is a Blazor Server UI library hosted in-process by PiProxyGuard.Api.
         It owns all dashboard components, view models and live-update plumbing,
         so the UI is a separate assembly from the REST API. -->
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The Razor SDK (unlike the Web SDK) does not add these implicit global
       usings; the dashboard services/hosted service rely on them. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiProxyGuard.Infrastructure\PiProxyGuard.Infrastructure.csproj" />
  </ItemGroup>

</Project>
