@page "/settings"
@inherits ComponentBase
@inject DashboardService Dashboard

<PageTitle>Settings · PiProxyGuard</PageTitle>

<div class="page-header">
    <div>
        <h1>Settings</h1>
        <p class="muted">Notification channels, threat-intelligence providers, the daily digest, the background scan and GeoIP databases.</p>
    </div>
</div>

@if (_model is null)
{
    <section class="panel"><p class="muted pad">Loading…</p></section>
}
else
{
    <section class="panel">
        <div class="panel-head"><h2>General</h2></div>
        <div class="form-grid pad">
            <label class="field">
                <span class="field-label">Minimum severity</span>
                <select class="input" @bind="_minimumSeverity">
                    <option value="Info">Info</option>
                    <option value="Warning">Warning</option>
                    <option value="Critical">Critical</option>
                </select>
            </label>
            <p class="muted small selfcenter">Only alerts at or above this level are delivered.</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Telegram</h2>
            <label class="switch">
                <input type="checkbox" @bind="_telegramEnabled" />
                <span>Enabled</span>
            </label>
        </div>
        <div class="form-grid pad">
            <label class="field grow">
                <span class="field-label">Bot token</span>
                <div class="input-eye">
                    <input class="input" type="@(_showTelegramToken ? "text" : "password")" autocomplete="new-password"
                           placeholder="@TelegramTokenPlaceholder" @bind="_telegramBotToken" />
                    <button type="button" class="eye-btn" tabindex="-1"
                            title="@(_showTelegramToken ? "Hide" : "Show")" aria-label="@(_showTelegramToken ? "Hide value" : "Show value")"
                            @onclick="@(() => _showTelegramToken = !_showTelegramToken)">@(_showTelegramToken ? EyeOffIcon : EyeIcon)</button>
                </div>
            </label>
            <label class="field">
                <span class="field-label">Chat id</span>
                <div class="input-eye">
                    <input class="input" type="@(_showTelegramChatId ? "text" : "password")" autocomplete="off"
                           placeholder="123456789 or -1001234567890" @bind="_telegramChatId" />
                    <button type="button" class="eye-btn" tabindex="-1"
                            title="@(_showTelegramChatId ? "Hide" : "Show")" aria-label="@(_showTelegramChatId ? "Hide value" : "Show value")"
                            @onclick="@(() => _showTelegramChatId = !_showTelegramChatId)">@(_showTelegramChatId ? EyeOffIcon : EyeIcon)</button>
                </div>
            </label>
        </div>
        <div class="form-row pad">
            <button type="button" class="btn ghost" @onclick="@(() => TestAsync("Telegram"))" disabled="@_busy">Send test</button>
            <p class="muted small">Create a bot with @@BotFather, then get your chat id (e.g. from @@userinfobot).</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Email (SMTP)</h2>
            <label class="switch">
                <input type="checkbox" @bind="_emailEnabled" />
                <span>Enabled</span>
            </label>
        </div>
        <div class="form-grid pad">
            <label class="field grow">
                <span class="field-label">SMTP host</span>
                <input class="input" placeholder="smtp.example.com" @bind="_emailHost" />
            </label>
            <label class="field">
                <span class="field-label">Port</span>
                <input class="input narrow" type="number" min="1" max="65535" @bind="_emailPort" />
            </label>
            <label class="field check">
                <input type="checkbox" @bind="_emailUseSsl" />
                <span class="field-label">Use SSL/TLS</span>
            </label>
            <label class="field">
                <span class="field-label">Username</span>
                <input class="input" autocomplete="off" placeholder="optional" @bind="_emailUsername" />
            </label>
            <label class="field">
                <span class="field-label">Password</span>
                <div class="input-eye">
                    <input class="input" type="@(_showEmailPassword ? "text" : "password")" autocomplete="new-password"
                           placeholder="@EmailPasswordPlaceholder" @bind="_emailPassword" />
                    <button type="button" class="eye-btn" tabindex="-1"
                            title="@(_showEmailPassword ? "Hide" : "Show")" aria-label="@(_showEmailPassword ? "Hide value" : "Show value")"
                            @onclick="@(() => _showEmailPassword = !_showEmailPassword)">@(_showEmailPassword ? EyeOffIcon : EyeIcon)</button>
                </div>
            </label>
            <label class="field">
                <span class="field-label">From address</span>
                <input class="input" placeholder="piproxyguard@host" @bind="_emailFrom" />
            </label>
            <label class="field grow">
                <span class="field-label">To (comma-separated)</span>
                <input class="input" placeholder="you@host, ops@host" @bind="_emailTo" />
            </label>
        </div>
        <div class="form-row pad">
            <button type="button" class="btn ghost" @onclick="@(() => TestAsync("Email"))" disabled="@_busy">Send test</button>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Threat intelligence</h2>
        </div>
        <div class="form-grid pad">
            <label class="switch">
                <input type="checkbox" @bind="_urlhausEnabled" />
                <span>URLhaus (free, no key)</span>
            </label>
            <p class="muted small selfcenter">abuse.ch URLhaus host lookup — on by default.</p>

            <label class="field grow">
                <span class="field-label">VirusTotal API key</span>
                <div class="input-eye">
                    <input class="input" type="@(_showVirusTotalKey ? "text" : "password")" autocomplete="new-password"
                           placeholder="@VirusTotalKeyPlaceholder" @bind="_virusTotalApiKey" />
                    <button type="button" class="eye-btn" tabindex="-1"
                            title="@(_showVirusTotalKey ? "Hide" : "Show")" aria-label="@(_showVirusTotalKey ? "Hide value" : "Show value")"
                            @onclick="@(() => _showVirusTotalKey = !_showVirusTotalKey)">@(_showVirusTotalKey ? EyeOffIcon : EyeIcon)</button>
                </div>
            </label>
            <label class="field grow">
                <span class="field-label">AbuseIPDB API key</span>
                <div class="input-eye">
                    <input class="input" type="@(_showAbuseKey ? "text" : "password")" autocomplete="new-password"
                           placeholder="@AbuseIpDbKeyPlaceholder" @bind="_abuseIpDbApiKey" />
                    <button type="button" class="eye-btn" tabindex="-1"
                            title="@(_showAbuseKey ? "Hide" : "Show")" aria-label="@(_showAbuseKey ? "Hide value" : "Show value")"
                            @onclick="@(() => _showAbuseKey = !_showAbuseKey)">@(_showAbuseKey ? EyeOffIcon : EyeIcon)</button>
                </div>
            </label>
            <label class="field">
                <span class="field-label">AbuseIPDB score threshold (1-100)</span>
                <input class="input" type="number" min="1" max="100" @bind="_abuseThreshold" />
            </label>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Daily digest</h2>
            <label class="switch">
                <input type="checkbox" @bind="_digestEnabled" />
                <span>Enabled</span>
            </label>
        </div>
        <div class="form-grid pad">
            <label class="field">
                <span class="field-label">Send at (local hour, 0-23)</span>
                <input class="input" type="number" min="0" max="23" @bind="_digestHour" />
            </label>
            <label class="field">
                <span class="field-label">Window (hours)</span>
                <input class="input" type="number" min="1" max="720" @bind="_digestWindow" />
            </label>
            <p class="muted small selfcenter">A traffic-and-security summary delivered through the enabled notification channels.</p>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Background scan</h2>
            <label class="switch">
                <input type="checkbox" @bind="_scanEnabled" />
                <span>Enabled</span>
            </label>
        </div>
        <div class="form-grid pad">
            <label class="field">
                <span class="field-label">Interval (hours)</span>
                <input class="input" type="number" min="1" max="168" @bind="_scanInterval" />
            </label>
            <label class="field">
                <span class="field-label">Lookback (hours)</span>
                <input class="input" type="number" min="1" max="720" @bind="_scanLookback" />
            </label>
            <label class="field">
                <span class="field-label">Top hosts per cycle</span>
                <input class="input" type="number" min="1" max="1000" @bind="_scanTop" />
            </label>
            <label class="field">
                <span class="field-label">Delay between lookups (ms)</span>
                <input class="input" type="number" min="0" max="60000" @bind="_scanDelay" />
            </label>
            <label class="switch">
                <input type="checkbox" @bind="_scanAutoBlock" />
                <span>Auto-block malicious hosts</span>
            </label>
            <label class="field">
                <span class="field-label">Auto-block TTL (hours, 0 = permanent)</span>
                <input class="input" type="number" min="0" @bind="_scanTtl" />
            </label>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>GeoIP databases</h2>
            <span class="muted small">@(_security?.GeoIpActive == true ? "Loaded" : "Not loaded")</span>
        </div>
        <div class="form-grid pad">
            <label class="field grow">
                <span class="field-label">GeoLite2-Country .mmdb path</span>
                <input class="input" type="text" autocomplete="off"
                       placeholder="/var/lib/piproxyguard/GeoLite2-Country.mmdb" @bind="_geoCountryPath" />
            </label>
            <label class="field grow">
                <span class="field-label">GeoLite2-ASN .mmdb path</span>
                <input class="input" type="text" autocomplete="off"
                       placeholder="/var/lib/piproxyguard/GeoLite2-ASN.mmdb" @bind="_geoAsnPath" />
            </label>
            <p class="muted small selfcenter">Offline MaxMind GeoLite2 files on the Pi. Changes are applied without a restart.</p>
        </div>
    </section>

    <section class="panel">
        <div class="form-row pad">
            <button type="button" class="btn primary" @onclick="SaveAsync" disabled="@_busy">Save settings</button>
            @if (_error is not null)
            {
                <p class="form-error">@_error</p>
            }
            @if (_info is not null)
            {
                <p class="form-info">@_info</p>
            }
        </div>
    </section>
}

@code {
    private static readonly MarkupString EyeIcon = (MarkupString)
        "<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    private static readonly MarkupString EyeOffIcon = (MarkupString)
        "<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24\"/><line x1=\"1\" y1=\"1\" x2=\"23\" y2=\"23\"/></svg>";

    private NotificationSettingsViewModel? _model;

    private string _minimumSeverity = "Warning";

    private bool _telegramEnabled;
    private string _telegramBotToken = string.Empty;
    private string _telegramChatId = string.Empty;

    private bool _emailEnabled;
    private string _emailHost = string.Empty;
    private int _emailPort = 587;
    private bool _emailUseSsl = true;
    private string _emailUsername = string.Empty;
    private string _emailPassword = string.Empty;
    private string _emailFrom = string.Empty;
    private string _emailTo = string.Empty;

    private SecuritySettingsViewModel? _security;

    private string _geoCountryPath = string.Empty;
    private string _geoAsnPath = string.Empty;

    private bool _urlhausEnabled = true;
    private string _virusTotalApiKey = string.Empty;
    private string _abuseIpDbApiKey = string.Empty;
    private int _abuseThreshold = 50;
    private bool _showVirusTotalKey;
    private bool _showAbuseKey;

    private bool _digestEnabled;
    private int _digestHour = 8;
    private int _digestWindow = 24;

    private bool _scanEnabled;
    private int _scanInterval = 6;
    private int _scanLookback = 24;
    private int _scanTop = 50;
    private int _scanDelay = 1500;
    private bool _scanAutoBlock = true;
    private int _scanTtl;

    private bool _showTelegramToken;
    private bool _showTelegramChatId;
    private bool _showEmailPassword;

    private bool _busy;
    private string? _error;
    private string? _info;

    private string TelegramTokenPlaceholder =>
        _model?.TelegramHasToken == true
            ? $"{_model.TelegramTokenPreview} (saved — leave blank to keep)"
            : "123456:ABC-DEF…";

    private string EmailPasswordPlaceholder =>
        _model?.EmailHasPassword == true
            ? "•••••• (saved — leave blank to keep)"
            : "optional";

    private string VirusTotalKeyPlaceholder =>
        _security?.VirusTotalHasKey == true
            ? $"{_security.VirusTotalKeyPreview} (saved — leave blank to keep)"
            : "optional";

    private string AbuseIpDbKeyPlaceholder =>
        _security?.AbuseIpDbHasKey == true
            ? $"{_security.AbuseIpDbKeyPreview} (saved — leave blank to keep)"
            : "optional";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var model = await Dashboard.GetNotificationSettingsAsync();
        _model = model;

        _minimumSeverity = model.MinimumSeverity;

        _telegramEnabled = model.TelegramEnabled;
        _telegramBotToken = string.Empty;
        _telegramChatId = model.TelegramChatId ?? string.Empty;

        _emailEnabled = model.EmailEnabled;
        _emailHost = model.EmailHost ?? string.Empty;
        _emailPort = model.EmailPort > 0 ? model.EmailPort : 587;
        _emailUseSsl = model.EmailUseSsl;
        _emailUsername = model.EmailUsername ?? string.Empty;
        _emailPassword = string.Empty;
        _emailFrom = model.EmailFrom ?? string.Empty;
        _emailTo = model.EmailTo ?? string.Empty;

        var security = await Dashboard.GetSecuritySettingsAsync();
        _security = security;

        _geoCountryPath = security.GeoIpCountryDatabasePath ?? string.Empty;
        _geoAsnPath = security.GeoIpAsnDatabasePath ?? string.Empty;

        _urlhausEnabled = security.UrlhausEnabled;
        _virusTotalApiKey = string.Empty;
        _abuseIpDbApiKey = string.Empty;
        _abuseThreshold = security.AbuseIpDbScoreThreshold;

        _digestEnabled = security.DailyDigestEnabled;
        _digestHour = security.DailyReportHour;
        _digestWindow = security.DigestWindowHours;

        _scanEnabled = security.ScanEnabled;
        _scanInterval = security.ScanIntervalHours;
        _scanLookback = security.ScanLookbackHours;
        _scanTop = security.ScanTopDomains;
        _scanDelay = security.ScanRequestDelayMs;
        _scanAutoBlock = security.ScanAutoBlock;
        _scanTtl = security.ScanAutoBlockTtlHours;
    }

    private NotificationSettingsInput BuildInput() => new()
    {
        MinimumSeverity = _minimumSeverity,
        TelegramEnabled = _telegramEnabled,
        TelegramBotToken = NullIfEmpty(_telegramBotToken),
        TelegramChatId = NullIfEmpty(_telegramChatId),
        EmailEnabled = _emailEnabled,
        EmailHost = NullIfEmpty(_emailHost),
        EmailPort = _emailPort,
        EmailUseSsl = _emailUseSsl,
        EmailUsername = NullIfEmpty(_emailUsername),
        EmailPassword = NullIfEmpty(_emailPassword),
        EmailFrom = NullIfEmpty(_emailFrom),
        EmailTo = NullIfEmpty(_emailTo)
    };

    private SecuritySettingsInput BuildSecurityInput() => new()
    {
        GeoIpCountryDatabasePath = NullIfEmpty(_geoCountryPath),
        GeoIpAsnDatabasePath = NullIfEmpty(_geoAsnPath),
        UrlhausEnabled = _urlhausEnabled,
        VirusTotalApiKey = NullIfEmpty(_virusTotalApiKey),
        AbuseIpDbApiKey = NullIfEmpty(_abuseIpDbApiKey),
        AbuseIpDbScoreThreshold = _abuseThreshold,
        DailyDigestEnabled = _digestEnabled,
        DailyReportHour = _digestHour,
        DigestWindowHours = _digestWindow,
        ScanEnabled = _scanEnabled,
        ScanIntervalHours = _scanInterval,
        ScanLookbackHours = _scanLookback,
        ScanTopDomains = _scanTop,
        ScanRequestDelayMs = _scanDelay,
        ScanAutoBlock = _scanAutoBlock,
        ScanAutoBlockTtlHours = _scanTtl
    };

    private async Task SaveAsync()
    {
        _error = _info = null;
        _busy = true;
        try
        {
            var result = await Dashboard.SaveNotificationSettingsAsync(BuildInput());
            if (!result.Success)
            {
                _error = result.Error;
                return;
            }

            var securityResult = await Dashboard.SaveSecuritySettingsAsync(BuildSecurityInput());
            if (!securityResult.Success)
            {
                _error = securityResult.Error;
                return;
            }

            _info = "Settings saved.";
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestAsync(string channel)
    {
        _error = _info = null;
        _busy = true;
        try
        {
            // Save first so the test uses exactly what is on screen.
            var saved = await Dashboard.SaveNotificationSettingsAsync(BuildInput());
            if (!saved.Success)
            {
                _error = saved.Error;
                return;
            }

            var result = await Dashboard.SendTestNotificationAsync(channel);
            if (result.Success)
            {
                _info = $"{channel} test sent — check the channel.";
                await LoadAsync();
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
