{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=/var/lib/piproxyguard/piproxyguard.db"
  },
  "AccessLog": {
    "Path": "/var/log/squid/access.log",
    "PollIntervalSeconds": 15,
    "BatchSize": 500,
    "RetentionDays": 90
  },
  "Blocklist": {
    "UpdateIntervalHours": 12,
    "AclFilePath": "/etc/squid/blocked_domains.acl",
    "ReloadCommand": "squid -k reconfigure",
    "Feeds": [
      {
        "Url": "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
        "Format": "hosts"
      },
      {
        "Url": "https://urlhaus.abuse.ch/downloads/hostfile/",
        "Format": "hosts"
      }
    ]
  },
  "Detection": {
    "IntervalMinutes": 5,
    "WindowMinutes": 5,
    "DuplicateSuppressionMinutes": 60,
    "MaxRequestsPerWindow": 600,
    "MaxBytesPerWindow": 524288000,
    "MaxDeniedPerWindow": 20,
    "AutoBlockSuspiciousHosts": false,
    "AutoBlockTtlHours": 24,
    "DetectTrafficSpikes": true,
    "SpikeBaselineWindows": 12,
    "SpikeMultiplier": 5.0,
    "SpikeMinRequests": 100,
    "DetectSuspiciousDomains": true,
    "DomainEntropyThreshold": 3.8,
    "DomainMinLabelLength": 12,
    "ClientProfiles": [
      { "Match": "192.168.1.50", "Name": "kids-tablet", "Strictness": 0.5 },
      { "Match": "192.168.9.0/24", "Name": "guest-vlan", "MaxRequestsPerWindow": 200 }
    ]
  },
  "Notifications": {
    "MinimumSeverity": "Warning",
    "Telegram": { "BotToken": "", "ChatId": "" },
    "Email": {
      "Host": "", "Port": 587, "UseSsl": true,
      "Username": "", "Password": "", "From": "", "To": ""
    }
  },
  "ThreatIntel": {
    "UrlhausEnabled": true,
    "VirusTotalApiKey": "",
    "AbuseIpDbApiKey": "",
    "AbuseIpDbScoreThreshold": 50
  },
  "ThreatIntelScan": {
    "Enabled": false,
    "IntervalHours": 6,
    "LookbackHours": 24,
    "TopDomains": 50,
    "RequestDelayMs": 1500,
    "AutoBlock": true,
    "AutoBlockTtlHours": 0
  },
  "Reports": {
    "DailyDigestEnabled": false,
    "DailyReportHour": 8,
    "WindowHours": 24,
    "Title": "PiProxyGuard daily digest",
    "Severity": "Warning"
  },
  "GeoIp": {
    "CountryDatabasePath": "",
    "AsnDatabasePath": ""
  }
}
