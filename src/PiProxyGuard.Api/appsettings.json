{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=/var/lib/piproxyguard/piproxyguard.db"
  },
  "Api": {
    "ApiKey": ""
  },
  "Blocklist": {
    "UpdateIntervalHours": 12,
    "AclFilePath": "/etc/squid/blocked_domains.acl",
    "ReloadCommand": "squid -k reconfigure",
    "Feeds": [
      {
        "Url": "https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts",
        "Format": "hosts"
      },
      {
        "Url": "https://urlhaus.abuse.ch/downloads/hostfile/",
        "Format": "hosts"
      }
    ]
  },
  "Detection": {
    "IntervalMinutes": 5,
    "WindowMinutes": 5,
    "MaxRequestsPerWindow": 600,
    "MaxBytesPerWindow": 524288000,
    "MaxDeniedPerWindow": 20
  }
}
